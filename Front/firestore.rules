rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['privacyPolicyVersion', 'privacyAcceptedAt'])
        && request.resource.data.privacyPolicyVersion is string
        && request.resource.data.privacyAcceptedAt is timestamp;
    }

    match /users/{userId}/{collectionName}/{documentId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId
        && collectionName in ['records', 'subscriptions'];
    }
  }
}
